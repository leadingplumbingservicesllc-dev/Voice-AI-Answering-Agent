# DEMO is free and never uses live providers. Node 24 loads this with --env-file=.env.
APP_MODE=demo
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_PATH=data/call-desk.sqlite
# Live: HTTPS origin only, no path. Persist /var/data on Render.
# PUBLIC_BASE_URL=https://YOUR-SERVICE.onrender.com
# DATABASE_PATH=/var/data/call-desk.sqlite
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
TWILIO_ACCOUNT_SID=AC_REPLACE_IN_DEPLOYMENT_SETTINGS
TWILIO_AUTH_TOKEN=REPLACE_IN_DEPLOYMENT_SETTINGS
TWILIO_NUMBER=+1_REPLACE_WITH_YOUR_TWILIO_NUMBER
PUBLIC_BUSINESS_NUMBER=+1_REPLACE_WITH_EXISTING_PUBLIC_NUMBER
TWILIO_MESSAGING_SERVICE_SID=
OPENAI_API_KEY=REPLACE_IN_DEPLOYMENT_SETTINGS
OPENAI_MODEL=gpt-4.1-mini
OWNER_ALERT_NUMBER=
SON_ALERT_NUMBER=
FALLBACK_NUMBER=
SECONDARY_FALLBACK_NUMBER=
FALLBACK_URL=
# Optional owner-only backup email: SMTP values must be raw, valid server credentials.
BACKUP_EMAIL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional AES-256-GCM backups. Use independent off-host storage + lifecycle expiration.
BACKUP_PASSPHRASE=
BACKUP_DIR=data/backups
# HTTPS PUT destination / presigned object URL. Renew before expiration; never commit it.
BACKUP_UPLOAD_URL=
