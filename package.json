{
  "name": "leading-call-desk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx src/cli.ts demo && concurrently -k \"tsx watch src/server.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/server.ts",
    "bootstrap": "tsx src/cli.ts bootstrap",
    "demo": "tsx src/cli.ts demo",
    "simulate": "tsx scripts/simulate.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit",
    "backup": "tsx src/cli.ts backup",
    "restore": "tsx src/cli.ts restore",
    "lint": "eslint .",
    "format": "prettier --write src web scripts tests *.ts *.json *.js *.md",
    "costs": "tsx scripts/costs.ts",
    "reset-password": "tsx src/cli.ts reset-password",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@fastify/cookie": "latest",
    "@fastify/formbody": "latest",
    "@fastify/passport": "^4.0.4",
    "@fastify/rate-limit": "latest",
    "@fastify/session": "^11.1.5",
    "@fastify/static": "latest",
    "@fastify/websocket": "latest",
    "@node-rs/argon2": "latest",
    "better-sqlite3": "latest",
    "fastify": "latest",
    "lucide-react": "latest",
    "nodemailer": "^10.2.1",
    "openai": "latest",
    "passport-local": "^1.0.0",
    "react": "latest",
    "react-dom": "latest",
    "twilio": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@tailwindcss/vite": "latest",
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-local": "^1.0.38",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/ws": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "^8.72.0",
    "vite": "latest",
    "vitest": "latest"
  }
}
